MONGO_URI=mongodb://127.0.0.1:27017/altitude
PORT=5000
NODE_ENV=development
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
GROQ_API_KEY=your_groq_api_key_here
# Optional: max add-on spend as a fraction of trek base price (default 0.25)
ADDON_CAP_PERCENTAGE=0.25
# Optional: sends an AI-personalized booking receipt on confirmed payment.
# Requires 2FA enabled on the Gmail account, then an App Password generated
# at https://myaccount.google.com/apppasswords — not your normal password.
# Booking confirmation works fine without these; the receipt just silently
# won't send (logged as a warning, never as an error).
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here
